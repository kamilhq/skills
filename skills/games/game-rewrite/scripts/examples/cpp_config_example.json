  "<stdio.h>": "\\b(printf|fprintf|sprintf|snprintf|vsnprintf|FILE)\\b",
  "<stdlib.h>": "\\b(rand|srand|malloc|calloc|realloc|free|exit|atoi|abs|qsort)\\b",
