   "STATE_TITLE": "0",
   "STATE_PLAY": "1"
  },
  "headers": ["src_matched/GAME/include/Constants.h"],
  "families": {"KEYBOARD": "SDLK", "FONT": "TEXT"},
  "ignore": ["SDL_\\w+", "SDLK_\\w+"]
 },
 "headers": {
  "include/Game.h": "game/Game.h",
  "include/Renderer.h": "graphics/Renderer.h",
  "include/Entity.h": "entity/Entity.h",
  "include/Constants.h": "util/Constants.h"
 },
