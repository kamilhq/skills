  "<string>": "\\bstd::string\\b",
  "<vector>": "\\bstd::vector\\b"
 },
 "guard_prefix": "GAME_",
 "banner": "From the matched units {units} of the game's decompilation.",
 "thunk_symbols": "^\\?\\?__[EF]",
