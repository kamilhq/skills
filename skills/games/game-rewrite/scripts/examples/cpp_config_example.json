  "includes": ["stand_in_types\\.h"],
  "declspecs": ["noinline", "safebuffers", "nothrow"],
  "keywords": {"__fastcall": "", "__forceinline": "inline"}
 },
 "renames": {
  "members": {
   "fill_rect_xywh_rgb": "fill_rect",
   "print_string": "print",
   "set_color_rgb": "set_color"
  },
  "global": {
