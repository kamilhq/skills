{
 "about": "Made-up gen_skeleton config (rust/gen_skeleton.py generate) for a small 2D game whose function index comes from matched units named NNN_<address>_<topic>: every key once, with invented classes, modules, names and addresses. A real project's config has the same shape, only longer. Keys are described in references/rust.md section 11.",
 "default_module": "app",
 "modules": {
  "app": "main loop, the per-state function tables, start-up and shutdown",
  "game": "class Game: state machine, menus, saves, settings",
  "graphics": "class Renderer and its texture cache",
  "entity": "class EntityList (the singleton) and class Entity (its elements)",
  "world": "class World: rooms, tiles, the camera",
  "audio": "class AudioMixer and the songs (class Song)",
  "input": "class InputState: keyboard and controller polling",
  "text": "namespace text: fonts, printing, UTF-8",
  "filesystem": "FS_* functions: data archive, save folder",
  "maths": "random numbers and C numerics (hand-written)",
  "log": "log_* functions"
 },
 "skip": [
  {"units": ["_(crt|stl)$"], "reason": "C/C++ runtime: Rust std"},
  {"names": ["^(std::|type_info|dynamic_initializer_for_|dynamic_atexit_destructor_for_)", "^WinMain$"],
   "reason": "runtime, static initializer or entry point: Rust std, Cx::new, main.rs"},
  {"bases": ["Destructor", "ScalarDeletingDestructor", "CopyConstructor", "operator_assign"],
   "reason": "copy/destructor: Clone/Drop"}
 ],
 "handwritten": {
  "0x401230": "maths::random_float",
  "0x401260": "maths::seed_random"
 },
 "rename": {
  "0x40a3c0": "string_hash"
 },
 "classes": {
  "Game": {"rust": "Game", "module": "game", "role": "singleton",
           "files": [["_menu$", "menu"], ["_save$", "save"], [".", "game"]]},
  "Renderer": {"rust": "Renderer", "module": "graphics", "role": "singleton"},
  "TextureCache": {"rust": "TextureCache", "module": "graphics", "role": "subobject", "prefix": "textures_",
                   "file": "textures"},
  "World": {"rust": "World", "module": "world", "role": "singleton"},
  "Camera": {"rust": "Camera", "module": "world", "role": "subobject", "prefix": "camera_", "file": "camera"},
  "EntityList": {"rust": "EntityList", "module": "entity", "role": "singleton"},
  "Entity": {"rust": "Entity", "module": "entity", "role": "element", "file": "entity"},
  "Song": {"rust": "Song", "module": "audio", "role": "element", "file": "song"},
  "AudioMixer": {"rust": "AudioMixer", "module": "audio", "role": "singleton"},
  "InputState": {"rust": "InputState", "module": "input", "role": "singleton"},
  "Rect": {"rust": "Rect", "module": "maths", "role": "value"}
 },
 "namespaces": {
  "text": "text",
  "save": "game"
 },
 "names": {
  "text::utf8_next": "text/utf8",
  "text::utf8_len": "text/utf8",
  "save_settings": "game/settings"
 },
 "name_patterns": [
  ["_debug_overlay$", "graphics/debug"]
 ],
 "prefixes": [
  ["FS_", "filesystem", true],
  ["log_", "log", false]
 ],
 "addresses": {
  "0x40a3c0": "text/hash"
 },
 "units": [
  ["_main$", "app"],
  ["_math$", "maths"]
 ],
 "module_files": {
  "app": [["_states$", "states"], [".", "app"]],
  "filesystem": [["_archive$", "archive"], [".", "filesystem"]]
 },
 "cx": {
  "type": "Cx",
  "name": "cx",
  "mode": "analyse",
  "methods": "analyse",
  "state": ["(?<![\\w.>:])(game|renderer|world|ents|mixer|input)\\s*(?:\\.|->)"],
  "globals": true,
  "global_min_len": 5,
  "ignore_globals": ["count", "index", "width", "height", "buffer", "result", "state", "flags", "timer"],
  "pure": ["text::utf8_next", "text::utf8_len"],
  "needs": ["random_float"]
 },
 "skip_globals": {
  "names": ["^(game|renderer|world|ents|mixer|input)$", "^check_", "^std::"],
  "units": ["_(crt|stl)$"]
 },
 "global_modules": {
  "g_track_names": "audio",
  "g_key_names": "input"
 },
 "types": {
  "char": "u8",
  "Uint8": "u8",
  "Uint16": "u16",
  "Uint32": "u32",
  "Sint32": "i32",
  "SDL_Keycode": "i32",
  "SDL_Rect": "SdlRect",
  "SDL_Texture*": "Texture"
 },
 "param_types": {
  "const char**": "&mut &[u8]",
  "unsigned char**": "&mut Option<Vec<u8>>",
  "SDL_Rect*": "Option<&SdlRect>"
 },
 "return_types": {
  "Entity*": "Option<usize>",
  "Song*": "Option<usize>"
 },
 "drop_params": {
  "EntityList&": "the global entity list: cx.ents"
 },
 "enums": {
  "GameState": "GameState",
  "EntityKind": "EntityKind"
 },
 "varargs": "&[VArg]",
 "constants": {
  "MAX_PATH": 260,
  "MAX_ENTITIES": 200,
  "ROOM_WIDTH": 40,
  "ROOM_HEIGHT": 30
 },
 "imports": [
  "use crate::cx::Cx;",
  "use crate::ffi::sdl::{self, SdlRect, Texture};",
  "use crate::state::*;",
  "use crate::stub;",
  "use crate::cbuf::CBuf;"
 ],
 "statics": "src/state/statics.rs",
 "stub_macro": "stub",
 "keep": ["src/main.rs", "src/cx.rs", "src/maths.rs", "src/stub.rs", "src/cbuf.rs", "src/cnum.rs", "src/harness.rs"]
}
